# For local Docker testing only (docker run --env-file .env ...). On
# Railway, set these as Variables in the service dashboard instead — see
# README.md.

# Anthropic — optional server-side fallback; each drafting tool call can
# also pass its own api_key instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Voyage AI — hosted embeddings for the legal vault (no local ML stack)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2

# Only used by the optional embed_offline.py bulk-ingest script
LEGAL_VAULT_DIR=./legal_vault

# Pinecone — vector store backing the legal vault
PINECONE_API_KEY=
PINECONE_INDEX=legal-vault-index
