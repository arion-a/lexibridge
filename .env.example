# Anthropic — powers clause/memo drafting and summarization. Optional
# server-side fallback: each drafting tool call can pass its own `api_key`
# and `model` instead, so leave these blank if every caller brings their own.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local embedding model (ONNX, runs on-device — no API key needed)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2

# Offline ingestion (embed_offline.py)
LEGAL_VAULT_DIR=./legal_vault
LOCAL_VECTOR_STORE=./my_manual_vector.json

# Cloud bridge (server_cloud.py, deployed e.g. on Railway) that the local
# client sends precomputed query vectors to — never raw text.
CLOUD_SERVER_URL=https://your-app.up.railway.app/mcp

# Pinecone — vector store backing the legal vault (used by embed_offline.py
# to push vectors, and by server_cloud.py to query them)
PINECONE_API_KEY=
PINECONE_INDEX=legal-vault-index
